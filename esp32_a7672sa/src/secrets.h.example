// Modelo de credenciais locais. Copie para secrets.h e preencha.
//
// O secrets.h de verdade não é versionado: a senha do Wi-Fi é um segredo, e
// este repositório vai para o GitHub Pages.
//
// Sem secrets.h o firmware compila igual — só não conecta no Wi-Fi, e o mapa
// passa a funcionar apenas com os tiles que já estiverem no cache.
#pragma once

#define WIFI_SSID_LOCAL "sua-rede"
#define WIFI_PASS_LOCAL "sua-senha"
